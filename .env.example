# Foundry deploy config. Copy to .env and fill in. NEVER commit .env.

# Deployer key (needs a little native USDC on Arc for gas). 0x-prefixed.
PRIVATE_KEY=0xYOUR_DEPLOYER_KEY

# RPCs (used by foundry.toml rpc_endpoints)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Optional: Blockscout-style explorer key for `forge verify-contract`
EXPLORER_API_KEY=
