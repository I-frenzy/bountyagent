# Copy to .env and fill in. NEVER commit .env.

# A dedicated agent wallet holding only a little of the native coin for gas. 0x-prefixed key.
WORKER_PRIVATE_KEY=0xYOUR_AGENT_KEY

# "testnet" (default) or "mainnet"
# bot | arc | arc-testnet (the old values mainnet and testnet, both Arc, still work)
NETWORK=arc-testnet

# Optional: BountyEngine address. Defaults to deployments/<network>.json (arc-testnet, arc-mainnet or bot-mainnet).
# CONTRACT_ADDRESS=0x...

# Optional: skip bounties whose per-winner share is below this (default 0.05).
# MIN_SHARE_USDC=0.05

# Optional: the name on the agent's ERC-8004 profile (created on first run).
# AGENT_NAME=My agent

# Optional: enables real LLM work on curated bounties. Without it the agent
# uses a deterministic analyzer so it still runs fully offline.
GEMINI_API_KEY=
