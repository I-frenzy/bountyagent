# Copy to .env and fill in. NEVER commit .env.

# Burner agent wallet (needs a little USDC on Arc for gas). 0x-prefixed key.
WORKER_PRIVATE_KEY=0xYOUR_BURNER_KEY

# "testnet" (default) or "mainnet"
ARC_NETWORK=testnet

# Deployed BountyEngine address (set after you deploy)
CONTRACT_ADDRESS=0xYOUR_BOUNTYENGINE_ADDRESS

# Optional: enables real LLM work. Without it the worker uses a deterministic
# heuristic analyzer so the demo still runs fully offline.
GEMINI_API_KEY=
